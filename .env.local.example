# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_votre_cle_api

# Adresse d'envoi : doit appartenir à un domaine vérifié dans Resend.
# Sans domaine vérifié, Resend impose onboarding@resend.dev
# (et n'autorise l'envoi que vers l'email du compte Resend lui-même).
RESEND_FROM_EMAIL=DameJustice <onboarding@resend.dev>

# Boîte qui reçoit les demandes de démonstration
RESEND_TO_EMAIL=williams.stanley.desouza@gmail.com

# URL publique du site (metadata, sitemap)
NEXT_PUBLIC_SITE_URL=https://damejustice.com
